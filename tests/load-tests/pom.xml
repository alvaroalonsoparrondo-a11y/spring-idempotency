<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>

    <parent>
        <groupId>io.github.idempotency</groupId>
        <artifactId>spring-idempotency</artifactId>
        <version>0.1.0-SNAPSHOT</version>
        <relativePath>../../pom.xml</relativePath>
    </parent>

    <artifactId>load-tests</artifactId>
    <name>load-tests</name>
    <description>Gatling simulations against a running ride-service, run on purpose with gatling:test</description>

    <properties>
        <gatling.version>3.16.1</gatling.version>
        <gatling-maven-plugin.version>4.22.3</gatling-maven-plugin.version>
        <!-- Gatling runs on the Netty line it was built with, not the older one the Spring Boot parent manages -->
        <netty.version>4.2.20.Final</netty.version>
    </properties>

    <dependencies>
        <dependency>
            <groupId>io.gatling.highcharts</groupId>
            <artifactId>gatling-charts-highcharts</artifactId>
            <version>${gatling.version}</version>
            <scope>test</scope>
        </dependency>
    </dependencies>

    <build>
        <plugins>
            <!-- the simulations are not JUnit tests and run only through the Gatling plugin -->
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-surefire-plugin</artifactId>
                <configuration>
                    <skip>true</skip>
                </configuration>
            </plugin>
            <!-- not bound to a phase: ./mvnw -pl load-tests gatling:test against a running stack -->
            <plugin>
                <groupId>io.gatling</groupId>
                <artifactId>gatling-maven-plugin</artifactId>
                <version>${gatling-maven-plugin.version}</version>
                <configuration>
                    <simulationClass>io.github.idempotency.load.RideBookingSimulation</simulationClass>
                </configuration>
            </plugin>
        </plugins>
    </build>
</project>
